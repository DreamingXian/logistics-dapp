# ==========================================
# Logistics DApp - Environment Configuration
# ==========================================

# 1. IPFS Pinata Service (For Cargo & Delivery Proof Storage)
# Get free API keys from https://app.pinata.cloud/
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt_token

# 2. Ethereum Sepolia Testnet RPC (For deploying contracts to public network)
# Get free RPC URL from https://www.alchemy.com/ or https://infura.io/
# Note: ONLY needed if you want to deploy new smart contracts yourself.
# If testing existing deployed contracts, the DApp uses MetaMask directly!
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# 3. Deployer Account Private Key (NEVER commit real mainnet keys!)
# Note: ONLY needed for running 'truffle migrate --network sepolia'
DEPLOYER_PRIVATE_KEY=your_64_character_hex_private_key
